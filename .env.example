# Signals-only gold bot — credentials. NEVER commit this file with real values.
# Copy to .env and fill in. Values are read from .env or process env.

# OANDA v20 Practice (MAIN market-data feed)
# Create a free Practice account at register.oanda.com (fxTrade Practice),
# then generate a personal access token at hub.oanda.com (Manage API Access).
# Account ID looks like 001-011-1234567-001 (the v20 Account Number).
OANDA_API_TOKEN=
OANDA_ACCOUNT_ID=

# Telegram alerts (signals are posted to this chat via your own bot)
# Create the bot with @BotFather, then get your chat id (e.g. via @userinfobot).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional: force the feed (auto | oanda | deriv). Default is auto.
# FEED=auto
